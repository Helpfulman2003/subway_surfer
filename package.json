{
  "name": "subway-surfers-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "compile": "cross-env HARDHAT_IGNORE_NODE_VERSION=1 hardhat compile",
    "deploy:base": "cross-env HARDHAT_IGNORE_NODE_VERSION=1 hardhat run scripts/deploy.cjs --network base",
    "deploy:testnet": "cross-env HARDHAT_IGNORE_NODE_VERSION=1 hardhat run scripts/deploy.cjs --network base-sepolia",
    "verify:base": "cross-env HARDHAT_IGNORE_NODE_VERSION=1 hardhat verify --network base"
  },
  "dependencies": {
    "ethers": "^6.13.0",
    "ox": "^0.14.29",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "solc": "^0.8.35",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^7.0.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "hardhat": "^3.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^5.2.0"
  }
}
